generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  VENDOR
  DELIVERY
  ADMIN
}

enum OrderStatus {
  PENDING
  RECEIVED
  PACKED
  HANDED_TO_DELIVERY
  DELIVERED
  CANCELLED
  DISPUTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
}

enum DeliveryAssignmentStatus {
  ASSIGNED
  PICKUP_CONFIRMED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryEarningStatus {
  PENDING
  RELEASED
  CANCELLED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MobileSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  app              String    @default("CUSTOMER_APP")
  deviceId         String?
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@index([app, createdAt])
  @@index([accessTokenHash, expiresAt])
  @@index([refreshTokenHash, refreshExpiresAt])
}

model MobileAuthCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app        String
  platform   String
  deviceId   String
  pushToken  String   @unique
  provider   String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, app, deviceId])
  @@index([userId, app])
  @@index([app, platform])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String
  key         String
  requestHash String
  status      String   @default("PROCESSING")
  statusCode  Int?
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@index([userId, scope, status])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(CUSTOMER)
  image         String?
  phone         String?
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  vendorProfile      Vendor?
  deliveryProfile    DeliveryPartner?
  orders             Order[]
  reviews            Review[]
  vendorReviews      VendorReview[]
  wishlist           Wishlist[]
  addresses          Address[]
  notifications      Notification[]
  paymentAttempts    PaymentAttempt[]
  supportTickets     SupportTicket[]
  cartItems          CartItem[]
  supportMessages    SupportMessage[]
  analyticsEvents    AnalyticsEvent[]
  performanceMetrics PerformanceMetric[]
  mobileSessions     MobileSession[]
  mobileAuthCodes    MobileAuthCode[]
  deviceTokens       DeviceToken[]
  idempotencyKeys    IdempotencyKey[]
  deliveryEvents     DeliveryStatusEvent[]

  @@index([role, createdAt])
  @@index([role, isBanned])
}

model DeliveryPartner {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String?
  phone         String?
  provider      String               @default("FITBAZAR")
  vehicleType   String?
  vehicleNumber String?
  currentZone   String?
  isActive      Boolean              @default(true)
  isSuspended   Boolean              @default(false)
  assignments   DeliveryAssignment[]
  earnings      DeliveryEarning[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, isSuspended])
  @@index([provider, isActive])
  @@index([currentZone])
}

model Vendor {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id])
  shopName           String
  slug               String         @unique
  logo               String?
  banner             String?
  description        String?
  category           String?
  phone              String?
  address            String?
  zone               String?
  district           String?
  panNumber          String?
  bankAccount        String?
  bankName           String?
  accountNumber      String?
  accountHolder      String?
  verificationStatus String         @default("PENDING")
  adminNotes         String?
  isApproved         Boolean        @default(false)
  isSuspended        Boolean        @default(false)
  isPartnered        Boolean        @default(false)
  isTopShop          Boolean        @default(false)
  partnerStatus      String         @default("NONE")
  partnerPlan        String?
  partnerRequestedAt DateTime?
  partnerStartedAt   DateTime?
  partnerExpiresAt   DateTime?
  partnerRenewedAt   DateTime?
  partnerPaymentDue  Float?
  partnerPaymentNote String?
  commissionPct      Float          @default(8.0)
  products           Product[]
  orders             Order[]
  reviews            VendorReview[]
  createdAt          DateTime       @default(now())

  @@index([isApproved, isSuspended, isPartnered])
  @@index([isApproved, isSuspended])
  @@index([partnerStatus, partnerExpiresAt])
  @@index([isTopShop, createdAt])
  @@index([createdAt])
  @@index([shopName])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  image     String?
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
  createdAt DateTime   @default(now())
}

model Product {
  id               String        @id @default(cuid())
  vendorId         String
  vendor           Vendor        @relation(fields: [vendorId], references: [id])
  name             String
  slug             String        @unique
  description      String?
  price            Float
  compareAtPrice   Float?
  discountPct      Int           @default(0)
  images           String[]
  category         String
  sizes            String[]
  colors           String[]
  stock            Int           @default(0)
  totalSold        Int           @default(0)
  isFestivalSale   Boolean       @default(false)
  isYearRoundSale  Boolean       @default(false)
  isFeatured       Boolean       @default(false)
  homepageSlot     String        @default("AUTO")
  homepagePriority Int           @default(0)
  isActive         Boolean       @default(true)
  status           ProductStatus @default(DRAFT)
  tags             String[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  categoryRef Category?   @relation(fields: [categoryId], references: [id])
  categoryId  String?
  orderItems  OrderItem[]
  reviews     Review[]
  wishlist    Wishlist[]
  cartItems   CartItem[]

  @@index([status, isActive, createdAt])
  @@index([status, isActive, totalSold])
  @@index([status, isActive, category, totalSold])
  @@index([status, isActive, category, createdAt])
  @@index([status, isActive, discountPct, totalSold])
  @@index([status, isActive, homepageSlot, homepagePriority])
  @@index([status, category])
  @@index([status, discountPct])
  @@index([status, totalSold])
  @@index([homepageSlot, homepagePriority])
  @@index([vendorId, status])
  @@index([createdAt])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique
  checkoutGroupId    String?
  customerId         String
  customer           User                @relation(fields: [customerId], references: [id])
  vendorId           String
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  items              OrderItem[]
  totalAmount        Float
  commissionAmt      Float
  vendorPayout       Float
  status             OrderStatus         @default(PENDING)
  paymentMethod      String
  paymentStatus      String              @default("PENDING")
  paymentReference   String?
  deliveryAddress    Json
  trackingNumber     String?
  adminNote          String?
  isDisputed         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  vendorReviews      VendorReview[]
  deliveryAssignment DeliveryAssignment?

  @@index([checkoutGroupId])
  @@index([customerId, createdAt])
  @@index([vendorId, createdAt])
  @@index([vendorId, status, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

model DeliveryAssignment {
  id              String                   @id @default(cuid())
  orderId         String                   @unique
  order           Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId       String?
  partner         DeliveryPartner?         @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  status          DeliveryAssignmentStatus @default(ASSIGNED)
  pickupCode      String?
  deliveryCode    String?
  pickupAt        DateTime?
  inTransitAt     DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  proofImageUrl   String?
  customerContact String?
  routeNote       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  events          DeliveryStatusEvent[]
  earning         DeliveryEarning?

  @@index([partnerId, status, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model DeliveryStatusEvent {
  id           String                   @id @default(cuid())
  assignmentId String
  assignment   DeliveryAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actorUserId  String?
  actorUser    User?                    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  status       DeliveryAssignmentStatus
  note         String?
  location     Json?
  createdAt    DateTime                 @default(now())

  @@index([assignmentId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([status, createdAt])
}

model DeliveryEarning {
  id           String                @id @default(cuid())
  assignmentId String                @unique
  assignment   DeliveryAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  partnerId    String
  partner      DeliveryPartner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount       Float
  status       DeliveryEarningStatus @default(PENDING)
  releasedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([partnerId, status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  size      String?
  color     String?
  price     Float
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, vendorId])
  @@index([vendorId, isVisible, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String
  line1     String
  zone      String
  district  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Banner {
  id           String    @id @default(cuid())
  imageUrl     String
  linkUrl      String?
  title        String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Int
  maxUses     Int
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model FestivalConfig {
  id       String   @id @default(cuid())
  name     String
  nameNp   String
  endDate  DateTime
  isActive Boolean  @default(false)
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  results   Int
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                 String  @id @default(cuid())
  commissionPct      Float   @default(8.0)
  minFreeDelivery    Float   @default(2000)
  whatsappNumber     String  @default("977XXXXXXXXX")
  announcementBar    String?
  announcementActive Boolean @default(false)
  supportEmail       String  @default("support@fitbazar.com")
  supportPhone       String  @default("+977 9800000000")
  supportHours       String?
  heroEyebrow        String  @default("Nepal's premium fashion marketplace")
  heroTitle          String  @default("Discover sharper style, faster shopping, and curated Nepal-first fashion.")
  heroSubtitle       String  @default("Mobile-first discovery, partner-led fashion drops, and cleaner product storytelling built for modern shoppers.")
  heroPrimaryLabel   String  @default("Shop New Arrivals")
  heroPrimaryHref    String  @default("/products")
  heroSecondaryLabel String  @default("Explore Collections")
  heroSecondaryHref  String  @default("/discover")
  seoImage           String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("GENERAL")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model SupportTicket {
  id            String           @id @default(cuid())
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  topic         String
  orderNumber   String?
  message       String
  status        String           @default("OPEN")
  adminResponse String?
  resolvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  messages      SupportMessage[]

  @@index([status, createdAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  sender    String
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  size      String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size, color])
}

model PaymentAttempt {
  id                String    @id @default(cuid())
  checkoutId        String    @unique
  customerId        String
  customer          User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethod     String
  amount            Float
  currency          String    @default("NPR")
  tokenHash         String    @unique
  payload           Json
  status            String    @default("PENDING")
  providerReference String?
  providerPayload   Json?
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([customerId, status])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId String?
  channel     String   @default("WEB")
  eventType   String
  path        String?
  referrer    String?
  userAgent   String?
  ipHash      String?
  deviceType  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([channel, createdAt])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([anonymousId, createdAt])
}

model PerformanceMetric {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId String?
  channel     String   @default("WEB")
  path        String?
  metricName  String
  value       Float
  unit        String   @default("ms")
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([channel, createdAt])
  @@index([metricName, createdAt])
  @@index([userId, createdAt])
}
