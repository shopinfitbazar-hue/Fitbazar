# Database setup
DATABASE_URL="postgresql://user:password@localhost:5432/fitbazar?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/fitbazar?schema=public"

# NextAuth setup
NEXT_PUBLIC_SITE_URL="http://localhost:3002"
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="super-secret-secret"
# Google Console local redirect URI:
# http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""

# Cloudinary setup
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Payment Gateways
ESEWA_PRODUCT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="your_esewa_secret_key"
ESEWA_BASE_URL="https://rc-epay.esewa.com.np"
ESEWA_STATUS_BASE_URL="https://rc.esewa.com.np"
KHALTI_PUBLIC_KEY=""
KHALTI_SECRET_KEY=""
KHALTI_API_BASE_URL="https://dev.khalti.com/api/v2"
KHALTI_ENABLE_LOCAL_CARD="false"

CONNECTIPS_MERCHANT_ID=""
CONNECTIPS_APP_ID=""
CONNECTIPS_GATEWAY_URL=""
CONNECTIPS_VERIFY_URL=""

FONEPAY_MERCHANT_CODE=""
FONEPAY_GATEWAY_URL=""
FONEPAY_VERIFY_URL=""

# Email (Resend)
# Required for real forgot-password and verification emails
RESEND_API_KEY=""
EMAIL_FROM="noreply@fitbazar.com"
VENDOR_SUPPORT_EMAIL_FROM="vendorSupport@fitbazar.com"

# Optional 100k-read-path scaling layer
# Used for shared public catalog/search/vendor cache and later shared rate limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
FITBAZAR_CACHE_PREFIX="fitbazar"
FITBAZAR_REDIS_TIMEOUT_MS="400"
FITBAZAR_REDIS_CACHE_DISABLED="false"

# Observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
